--synthesis_resources = lut 8 
SUBDESIGN decode_h7a
( 
	data[2..0]	:	input;
	enable	:	input;
	eq[7..0]	:	output;
) 
VARIABLE 
	data_wire[2..0]	: WIRE;
	enable_wire	: WIRE;
	eq_node[7..0]	: WIRE;
	eq_wire[7..0]	: WIRE;
	w_anode545w[3..0]	: WIRE;
	w_anode562w[3..0]	: WIRE;
	w_anode572w[3..0]	: WIRE;
	w_anode582w[3..0]	: WIRE;
	w_anode592w[3..0]	: WIRE;
	w_anode602w[3..0]	: WIRE;
	w_anode612w[3..0]	: WIRE;
	w_anode622w[3..0]	: WIRE;

BEGIN 
	data_wire[] = data[];
	enable_wire = enable;
	eq[] = eq_node[];
	eq_node[7..0] = eq_wire[7..0];
	eq_wire[] = ( w_anode622w[3..3], w_anode612w[3..3], w_anode602w[3..3], w_anode592w[3..3], w_anode582w[3..3], w_anode572w[3..3], w_anode562w[3..3], w_anode545w[3..3]);
	w_anode545w[] = ( (w_anode545w[2..2] & (! data_wire[2..2])), (w_anode545w[1..1] & (! data_wire[1..1])), (w_anode545w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode562w[] = ( (w_anode562w[2..2] & (! data_wire[2..2])), (w_anode562w[1..1] & (! data_wire[1..1])), (w_anode562w[0..0] & data_wire[0..0]), enable_wire);
	w_anode572w[] = ( (w_anode572w[2..2] & (! data_wire[2..2])), (w_anode572w[1..1] & data_wire[1..1]), (w_anode572w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode582w[] = ( (w_anode582w[2..2] & (! data_wire[2..2])), (w_anode582w[1..1] & data_wire[1..1]), (w_anode582w[0..0] & data_wire[0..0]), enable_wire);
	w_anode592w[] = ( (w_anode592w[2..2] & data_wire[2..2]), (w_anode592w[1..1] & (! data_wire[1..1])), (w_anode592w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode602w[] = ( (w_anode602w[2..2] & data_wire[2..2]), (w_anode602w[1..1] & (! data_wire[1..1])), (w_anode602w[0..0] & data_wire[0..0]), enable_wire);
	w_anode612w[] = ( (w_anode612w[2..2] & data_wire[2..2]), (w_anode612w[1..1] & data_wire[1..1]), (w_anode612w[0..0] & (! data_wire[0..0])), enable_wire);
	w_anode622w[] = ( (w_anode622w[2..2] & data_wire[2..2]), (w_anode622w[1..1] & data_wire[1..1]), (w_anode622w[0..0] & data_wire[0..0]), enable_wire);
END;
